# GitHub Secrets의 ENV_PROD에 아래 내용을 값만 바꿔 그대로 등록
# CD가 배포 시 .env를 생성해 EC2(~/everytime/.env)로 전송하며, DOCKERHUB_USERNAME은 자동으로 추가됨
DB_HOST=YOUR_RDS_ENDPOINT.ap-northeast-2.rds.amazonaws.com
DB_PORT=3306
DB_NAME=everytime
DB_USERNAME=YOUR_DB_USERNAME
DB_PASSWORD=YOUR_DB_PASSWORD

# 최초 배포 시 테이블 생성이 필요하면 update, 이후 validate 권장
DDL_AUTO=validate
